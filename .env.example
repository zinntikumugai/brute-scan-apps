# Bルート認証情報（電力会社から取得したID/パスワード）
BROUTE_ID=your_broute_id_here
BROUTE_PASSWORD=your_broute_password_here

# シリアルポート。2 通りの書き方ができる（pyserial の serial_for_url）。
#
#  (A) ローカル USB 構成: RL7023 を直挿ししているデバイスパス
#      SERIAL_PORT=/dev/wisun
#      この構成では devices マッピングが要るので、compose は
#        docker compose -f docker-compose.yml -f docker-compose.usb.yml up
#      で起動し、SERIAL_DEVICE にホスト側の実パスを書く
#
#  (B) remote 構成: ESP32 ブリッジ経由（devices マッピングは不要）
#      SERIAL_PORT=socket://bridge:7001
#
SERIAL_PORT=socket://bridge:7001

# (A) のときだけ使う。ホスト側の RL7023 のデバイスパス
SERIAL_DEVICE=/dev/serial/by-id/usb-ROHM_BP35A1_XXXXXXXX-if00

# InfluxDB v2 設定（外部InfluxDBサーバー）
INFLUXDB_URL=http://your-influxdb-host:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=your_organization_name
INFLUXDB_BUCKET=power

# デバッグモード（オプション）
# DEBUG=1  # 有効にするとログが全てコンソールに出力される
